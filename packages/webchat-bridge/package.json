{
  "name": "@utlra/webchat-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebChat 渠道桥（ChatIRChannel 实现）：对接独立 chat-server，将 WS 事件翻译为 ChatIRInboundMessage，把 postMessage 翻译为 chat-server REST。",
  "main": "./dist/index.js",
