{
  "name": "amadues",
  "private": true,
  "description": "Amadues — agent stack (data plane + chat IR + inner runtime). See doc/",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build -w @utlra/chat-ir && npm run build -w @utlra/discord-bridge && npm run build -w @utlra/webchat-protocol && npm run build -w @utlra/webchat-bridge && npm run build -w @utlra/server && npm run build -w @utlra/dashboard && npm run build -w @utlra/ops-console",
    "build:chat-server": "npm run build -w @utlra/webchat-protocol && npm run build -w @utlra/chat-server",
    "build:agent-server": "npm run build -w @utlra/chat-ir && npm run build -w @utlra/discord-bridge && npm run build -w @utlra/webchat-protocol && npm run build -w @utlra/webchat-bridge && npm run build -w @utlra/server",
    "docker:agents:build": "docker compose -f deploy/agent/docker-compose.agent.yml build",
    "docker:agents:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agents-docker.ps1",
    "docker:agents:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/stop-agents-docker.ps1",
    "docker:agents:down:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/stop-all-agents.ps1",
    "docker:agents:up:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-all-agents.ps1",
    "docker:agents:restart:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/restart-all-agents.ps1",
    "docker:agents:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/rebuild-agents-docker.ps1",
    "docker:agents:up:kuroneko": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-kuroneko.ps1",
    "docker:agents:up:shiro": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-shiro.ps1",
    "docker:agents:up:gin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-gin.ps1",
    "docker:agents:up:aoi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-aoi.ps1",
    "docker:agents:up:yuanbao": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-yuanbao.ps1",
    "docker:agents:up:bot1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-bot1-local.ps1",
    "dev:agent:bot1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-bot1-local.ps1",
    "dev:agent:bot1:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/stop-agent-bot1-local.ps1",
    "dev:agent:bot1:fresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/refresh-agent-bot1-local.ps1",
    "docker:agents:up:bot2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-bot2-local.ps1",
    "dev:agent:bot2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/start-agent-bot2-local.ps1",
    "dev:agent:bot2:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/stop-agent-bot2-local.ps1",
    "dev:agent:bot2:fresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kuroneko/refresh-agent-bot2-local.ps1",
    "build:web-chat": "npm run build -w @utlra/webchat-protocol && npm run build -w @utlra/web-chat",
    "stop": "bash scripts/stop.sh",
    "start": "bash scripts/start.sh",
    "dev": "npm run dev:dashboard",
    "dev:dashboard": "npm run dev -w @utlra/dashboard",
    "dev:ops": "npm run dev -w @utlra/ops-console",
    "dev:drive9": "npm run dev -w @utlra/drive9-explorer",
    "dev:chat-server": "npm run build -w @utlra/webchat-protocol && npm run dev -w @utlra/chat-server",
    "dev:web-chat": "npm run build -w @utlra/webchat-protocol && npm run dev -w @utlra/web-chat",
    "dev:webchat-all": "npm run build -w @utlra/webchat-protocol && concurrently -n chat-server,web-chat -c cyan,green \"npm run dev -w @utlra/chat-server\" \"npm run dev -w @utlra/web-chat\"",
    "test": "npm run test -w @utlra/chat-ir && npm run test -w @utlra/webchat-protocol && npm run test -w @utlra/webchat-bridge && npm run test -w @utlra/feishu-bridge && npm run test -w @utlra/wechat-bridge && npm run test -w @utlra/chat-server && npm run test:unit -w @utlra/server",
    "test:server": "npm run test -w @utlra/server",
    "test:server:integration": "npm run test:integration -w @utlra/server",
    "smoke:zhipu": "node scripts/zhipu-api-smoke.mjs",
    "smoke:zhipu:vision": "node scripts/zhipu-api-smoke.mjs --vision",
    "metrics:context": "node scripts/context-metrics.mjs",
    "structurizr:generate": "node scripts/structurizr/code-to-dsl.mjs",
    "structurizr:diff": "node scripts/structurizr/diff-workspace.mjs",
    "structurizr:deps": "depcruise packages apps --config doc/structurizr/deps.rules.cjs --output-type err",
    "structurizr:check": "node scripts/structurizr/check-all.mjs",
    "observe:analyze-run": "node scripts/observe/analyze-run.mjs",
    "observe:compare-runs": "node scripts/observe/compare-runs.mjs",
    "sync:local-dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-local-dashboard.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^16.10.0",
    "typescript": "^5.4.5"
  }
}
