{
  "name": "@utlra/ops-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地运维控制台：可视化查看 / 启停 utlra 各项服务（Agent x2、Dashboard）",
  "scripts": {
    "server": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "concurrently -n ops-srv,ops-web -c yellow,blue \"npm run server\" \"npm run dev:web\"",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
}
