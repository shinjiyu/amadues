# WebChat 部署机密（请复制为 deploy/webchat/.env 并填值，**不要提交到 git**）
# Compose 会把它们注入 chat-server 容器。

# ── 必填（公网 / loginserver SSO 部署）──────────────────────────────
# loginserver 内网 REST 根（refresh / 未配 JWT 密钥时的远程 verify）。
# 同主机不在同 docker network → 用 host.docker.internal；同 network → 用 service 名。
WEBCHAT_LOGIN_SERVER_URL=http://host.docker.internal:5001

# 与 loginserver `JWT_SECRET_KEY` 相同 → access token 本地 HS256 验签，不再每请求 HTTP verify。
WEBCHAT_LOGIN_JWT_SECRET=

# loginserver 的 hosted 登录页 URL（浏览器跳过去的那张页面）。
# 推荐填同 origin 相对路径 `/login`：loginserver Nuxt 与 webchat 挂在同一 HTTPS 根域下，
# 登录后 token 经 localStorage 共享（见 doc/ops/webchat-deploy.md）。
WEBCHAT_LOGIN_PAGE_URL=/login

# loginserver Nuxt login 页读 `redirect` query 参数当回跳地址。
WEBCHAT_LOGIN_RETURN_PARAM=redirect

# loginserver 把 token 写到 localStorage 的 key 名（除非你 fork 改了，保持默认）。
WEBCHAT_LOGIN_TOKEN_STORAGE_KEY=access_token
WEBCHAT_LOGIN_REFRESH_STORAGE_KEY=refresh_token
WEBCHAT_LOGIN_USER_STORAGE_KEY=user

# 可选：loginserver hosted 登出页 URL；通常留空。
WEBCHAT_LOGOUT_PAGE_URL=

# 多个 admin 用逗号分隔；他们必须先在 loginserver 注册过同一邮箱。
WEBCHAT_ADMIN_EMAILS=

# 鉴权：公网必须 1；本地调试可 0（见 doc/ops/webchat-deploy.md § 本地开发）
WEBCHAT_AUTH_REQUIRED=1

# Cookie domain：留空则按请求 host 自动；多子域共享时填 `.example.com`
WEBCHAT_COOKIE_DOMAIN=

WEBCHAT_COOKIE_SECURE=auto

# CORS 白名单（必须明确，不能 `*`）
CHAT_SERVER_CORS_ORIGIN=https://example.com

# 子路径前缀（与外层 nginx 的 location 对应）
WEBCHAT_PUBLIC_BASE_PATH=/webchat
VITE_BASE=/webchat/

# ── Agent 旁路 ─────────────────────────────────────────────────────
# 共享 secret：正确即可登录任意 agent user_id（新增 robot 无需改此文件）。
# 若需额外收紧，可填逗号分隔 allowlist；留空 = 不限制 user_id。
WEBCHAT_AGENT_USER_ID=
WEBCHAT_AGENT_SECRET=

# ── 业务可选 ────────────────────────────────────────────────────────
WEBCHAT_GLOBAL_THREAD_ID=global
CHAT_SERVER_MAX_UPLOAD_SIZE=26214400
