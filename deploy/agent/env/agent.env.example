# Amadues agent instance — copy to <instance>.env and fill secrets (do not commit)
# Do not set PORT or UTLRA_DATA_ROOT (injected by docker-compose)
# 内脑引擎：DyFlow 单引擎（2026-06-02+）；无需 INNER_BRAIN_ENGINE。镜像：utlra/agent-server:latest

# ── LLM (at least one provider) ──
UTLRA_INNER_LLM_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_MODEL=glm-5.1
ZHIPU_VISION_MODEL=glm-5v-turbo
ZHIPU_THINKING=disabled
ZHIPU_MAX_TOKENS=4096
ZHIPU_MULTIMODAL_MAX_TOKENS=8192

# OpenAI-compatible alternative:
# UTLRA_INNER_LLM_PROVIDER=localmodule
# LOCALMODULE_API_KEY=
# LOCALMODULE_BASE_URL=https://your-endpoint/v1
# LOCALMODULE_MODEL=your-model

# ── Identity ──
UTLRA_AGENT_IM_SID=idp:agent:my-instance
UTLRA_PRIMARY_AGENT_SID=idp:agent:my-instance
UTLRA_AGENT_NAME=My Agent

# ── mem9 / drive9（推荐；申请见 doc/deploy/mem9-drive9-credentials.md）──
# mem9: https://mem9.ai/docs/  |  开通: curl -sX POST https://api.mem9.ai/v1alpha1/mem9s
# drive9: https://drive9.ai/skill.md  |  Key 格式 dat9_...
MEM9_API_KEY=
DRIVE9_SERVER=https://api.drive9.ai
DRIVE9_API_KEY=

# ── Channel: webchat | discord | none ──
UTLRA_CHAT_CHANNEL=webchat

WEBCHAT_API_BASE=https://your-host/webchat/api
WEBCHAT_WS_URL=wss://your-host/webchat/ws
WEBCHAT_AGENT_USER_ID=my-instance
WEBCHAT_AGENT_DISPLAY_NAME=My Agent
WEBCHAT_AGENT_SECRET=
WEBCHAT_GLOBAL_THREAD_ID=global
WEBCHAT_MIRROR_ASSETS=1
WEBCHAT_TENANT=default
# Other agent user ids on the same chat-server (comma-separated; omit self)
WEBCHAT_PEER_AGENT_USER_IDS=

# DISCORD_BOT_TOKEN=
# DISCORD_BRIDGE_INGEST=all

# ── Outer brain policy ──
UTLRA_OUTER_REPLY_LLM=1
UTLRA_OUTER_RUN_INNER=0
UTLRA_OUTER_HEARTBEAT_INTERVAL_MS=300000
UTLRA_OUTER_HEARTBEAT_THREAD_ID=webchat:global
UTLRA_KPI_AUTO_NEXT_BURST=1
UTLRA_OUTER_PROACTIVE_LEVEL=0
UTLRA_OUTER_MAX_AGENT_CHAIN=20
