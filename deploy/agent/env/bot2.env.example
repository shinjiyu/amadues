# Bot2 — webchat-lab 实验对（GLM-5.1-FP8 @ PocketCity localmodule）
# 复制为 bot2.env 并填入密钥（勿提交 git）
# 文档：doc/deploy/bot1-bot2-webchat-lab.md

UTLRA_INNER_LLM_PROVIDER=localmodule
LOCALMODULE_API_KEY=
LOCALMODULE_BASE_URL=https://ai.pocketcity.com
LOCALMODULE_MODEL=GLM-5.1-FP8
LOCALMODULE_VISION_MODEL=MiMo-V2.5
# describe_image 识图（智谱 Vision MCP）；与 UTLRA_INNER_LLM_PROVIDER 无关，必填方能识图
ZHIPU_API_KEY=

UTLRA_AGENT_IM_SID=idp:agent:bot2
UTLRA_PRIMARY_AGENT_SID=idp:agent:bot2
UTLRA_AGENT_NAME=Bot2

MEM9_API_KEY=
DRIVE9_SERVER=https://api.drive9.ai
DRIVE9_API_KEY=

UTLRA_CHAT_CHANNEL=webchat
WEBCHAT_API_BASE=https://kuroneko.chat/webchat-lab/api
WEBCHAT_WS_URL=wss://kuroneko.chat/webchat-lab/ws
WEBCHAT_AGENT_USER_ID=bot2
WEBCHAT_AGENT_DISPLAY_NAME=Bot2
WEBCHAT_AGENT_SECRET=
WEBCHAT_GLOBAL_THREAD_ID=global
WEBCHAT_MIRROR_ASSETS=1
WEBCHAT_TENANT=default
WEBCHAT_PEER_AGENT_USER_IDS=bot1

UTLRA_OUTER_REPLY_LLM=1
UTLRA_OUTER_RUN_INNER=0
UTLRA_OUTER_HEARTBEAT_INTERVAL_MS=300000
UTLRA_OUTER_HEARTBEAT_THREAD_ID=webchat:global
UTLRA_KPI_AUTO_NEXT_BURST=1
UTLRA_OUTER_PROACTIVE_LEVEL=0
UTLRA_OUTER_MAX_AGENT_CHAIN=20
