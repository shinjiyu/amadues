# Gin agent — 复制为 gin.env 并填入密钥（勿提交 git）

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_MODEL=glm-5.1
ZHIPU_VISION_MODEL=glm-5v-turbo
ZHIPU_THINKING=disabled
ZHIPU_MAX_TOKENS=4096
ZHIPU_MULTIMODAL_MAX_TOKENS=8192
UTLRA_INNER_LLM_PROVIDER=zhipu

UTLRA_AGENT_IM_SID=idp:agent:gin
UTLRA_PRIMARY_AGENT_SID=idp:agent:gin
UTLRA_AGENT_NAME=Gin

# mem9 / drive9 — 申请步骤: doc/deploy/mem9-drive9-credentials.md
# mem9: https://mem9.ai/  |  drive9: https://drive9.ai/skill.md
MEM9_API_KEY=
DRIVE9_SERVER=https://api.drive9.ai
DRIVE9_API_KEY=

UTLRA_CHAT_CHANNEL=webchat
WEBCHAT_API_BASE=http://host.docker.internal:8790/api
WEBCHAT_WS_URL=ws://host.docker.internal:8790/ws
WEBCHAT_AGENT_USER_ID=gin
WEBCHAT_AGENT_DISPLAY_NAME=Gin
WEBCHAT_AGENT_SECRET=
WEBCHAT_GLOBAL_THREAD_ID=global
WEBCHAT_MIRROR_ASSETS=1
WEBCHAT_TENANT=default
WEBCHAT_PEER_AGENT_USER_IDS=kuroneko,shiro,aoi

UTLRA_OUTER_REPLY_LLM=1
UTLRA_OUTER_RUN_INNER=0
UTLRA_OUTER_HEARTBEAT_INTERVAL_MS=300000
UTLRA_OUTER_HEARTBEAT_THREAD_ID=webchat:global
UTLRA_KPI_AUTO_NEXT_BURST=1
UTLRA_OUTER_PROACTIVE_LEVEL=0
UTLRA_OUTER_MAX_AGENT_CHAIN=20
