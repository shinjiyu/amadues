{
  "page": {
    "id": "kuroneko",
    "label": "依莉雅 Kuroneko",
    "order": 8,
    "description": "utlraKuroneko 本地开发：Dashboard + Drive9 Explorer"
  },
  "services": [
    {
      "id": "kuroneko-dashboard",
      "label": "Dashboard (5173)",
      "page": "kuroneko",
      "kind": "h5",
      "openUrl": "http://127.0.0.1:5173/",
      "commands": {
        "health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\kuroneko\\health-dashboard.ps1",
        "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\kuroneko\\start-dashboard.ps1",
        "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\kuroneko\\stop-dashboard.ps1"
      },
      "healthTimeoutMs": 10000,
      "startTimeoutMs": 60000
    },
    {
      "id": "kuroneko-drive9-explorer",
      "label": "Drive9 Explorer (7782)",
      "page": "kuroneko",
      "kind": "h5",
      "openUrl": "http://127.0.0.1:7782/",
      "commands": {
        "health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\kuroneko\\health-drive9.ps1",
        "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\kuroneko\\start-drive9.ps1",
        "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\kuroneko\\stop-drive9.ps1"
      },
      "startTimeoutMs": 90000,
      "healthTimeoutMs": 15000
    }
  ]
}
