# 通用 LLM 变量参考（勿提交真实 .env.*）
# 实例配置：deploy/agent/env/<instance>.env — 模板见 deploy/agent/env/agent.env.example
# 部署：doc/deploy/agent-quickstart.md
ZHIPU_API_KEY=

# GLM Coding Plan 专属 OpenAI 兼容端点（编码套餐用此，不要用通用 /api/paas/v4）
# https://docs.bigmodel.cn/cn/coding-plan/quick-start
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# 纯文本（以控制台编码套餐可用名为准）
# https://docs.bigmodel.cn/cn/guide/models/text/glm-5
ZHIPU_MODEL=glm-5.1

# 图文多模态单次调用（以控制台编码套餐可用名为准，默认 5V 系）
ZHIPU_VISION_MODEL=glm-5v-turbo

ZHIPU_THINKING=disabled
ZHIPU_MAX_TOKENS=4096
ZHIPU_MULTIMODAL_MAX_TOKENS=8192

# 独立 API 自测（不启动 server）：npm run smoke:zhipu  /  npm run smoke:zhipu:vision

# Pi-mono 控制器已内嵌于本仓库（packages/server/src/openkuroneko），无需 OPENKURONEKO_DIST。

# Pi-mono Auto 默认最大连续 tick 次数（Dashboard 可在 UI 覆盖）
# UTLRA_PI_AUTO_MAX_TICKS=500

# 外脑 burst 结束后若检测到「目标已完成」，可通过 shutdown API 晋升并关闭内脑（见 doc/inner-outer-protocol.md）
# （已移除 POST /api/outer/roundtrip 的 after_burst 单请求参数）
# UTLRA_OUTER_AFTER_BURST=promote_and_shutdown_if_complete

# set_goal 路径将 IM 线程历史拼入 goal 前缀：最多条数、历史块最大字符
# UTLRA_OUTER_THREAD_HISTORY_LIMIT=30
# UTLRA_OUTER_THREAD_HISTORY_MAX_CHARS=80000

# goal.md 中本地 ![](path) 图片：调用视觉模型追加「附图摘要」再跑 Pi-mono（需 ZHIPU_API_KEY）
# UTLRA_GOAL_VISION_ENRICH=1

# 外脑回复 LLM 改写（legacy；IM 主路径用 conversation loop）
# UTLRA_OUTER_REPLY_LLM=1

# 关闭 Dashboard「打开工作目录」（POST /api/workspaces/:id/reveal），共享/生产环境建议开启
# UTLRA_DISABLE_WORKSPACE_REVEAL=1

# ── Agent 核心（8787）──
PORT=8787
# Dashboard Vite 代理目标
VITE_UTLRA_API_TARGET=http://127.0.0.1:8787
# chat IR / 身份 / 附件落盘根（threads.json、identities.json、chat/uploads/ 都在此目录下）
# UTLRA_DATA_ROOT=data
# 全栈主助手 sid（Identity Pack [SELF]、外脑 pack、chat IR 默认参与者）
# 未设置时默认为 idp:agent:assistant
# UTLRA_PRIMARY_AGENT_SID=idp:agent:assistant
# 开发/回归需要内置 idp:user:demo 时设为 1（默认不种子，他人身份由渠道 upsert 或学习管线注册）
# UTLRA_SEED_DEMO_USER=1
# agent 自己的 sender_sid；省略则用 UTLRA_PRIMARY_AGENT_SID
UTLRA_AGENT_IM_SID=idp:agent:assistant
# 外脑默认 workspace_id（set_goal 等工具未指定时使用）
# UTLRA_OUTER_WORKSPACE_ID=default

# 外脑定时心跳（OuterHeartbeat + autonomy dispatch）
# UTLRA_OUTER_HEARTBEAT_INTERVAL_MS=300000
# UTLRA_OUTER_HEARTBEAT_THREAD_ID=webchat:global
# 若 channel=webchat 且已配 WEBCHAT_GLOBAL_THREAD_ID，代码会自动 fallback 为 webchat:<id>
# UTLRA_OUTER_HEARTBEAT_ENABLED=false 可关闭心跳

# ── Discord 渠道桥（ChatIRChannel 的当前实现）──
# DISCORD_BOT_TOKEN 留空 → agent 启动但 channel=NullChatIRChannel，HTTP POST /api/outer/inbound 仍可用。
# 1) 在 https://discord.com/developers/applications 创建 Application → Bot → Reset Token，把 token 粘到这里
# DISCORD_BOT_TOKEN=
# 2) Application 详情页的 Application ID（slash command 第二期才用，可不填）
# DISCORD_APPLICATION_ID=
# 3) 白名单 guild id（逗号分隔；为空 = 所有加入的服务器都生效；DM 始终接受）
# DISCORD_GUILDS=
# 4) 入站策略：all = 所有消息都同步进 chat IR（便于 OuterBrain 看上下文）
#                mention_only = 仅 @bot 或 DM 才同步（隐私域更小）
DISCORD_BRIDGE_INGEST=all
# 5) Discord 附件下载到本地 ChatAssetStore（推荐 1；CDN URL 会过期，0 仅适合短时调试）
DISCORD_BRIDGE_DOWNLOAD_ATTACHMENTS=1
# 6) 写入 ThreadRecord.tenant_id；默认 default
# DISCORD_BRIDGE_TENANT=default
