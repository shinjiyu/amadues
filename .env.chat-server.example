# chat-server 本地开发（`npm run dev:chat-server` 时自动加载，勿提交真实机密）
# 复制为仓库根 `.env.chat-server` 后按需修改。

PORT=8790
CHAT_SERVER_DATA_ROOT=apps/chat-server/data

# 0 = 不强制 loginserver；REST 可用 X-User-Id，WS 允许 anonymous hello
WEBCHAT_AUTH_REQUIRED=0

# 本地 dev 一般不需要以下字段；WEBCHAT_AUTH_REQUIRED=1 时才必填
# WEBCHAT_LOGIN_SERVER_URL=http://127.0.0.1:5001
# WEBCHAT_LOGIN_PAGE_URL=/login

CHAT_SERVER_CORS_ORIGIN=http://127.0.0.1:5180

# 可选：保留 agent user_id 时 hello 需 secret
# WEBCHAT_AGENT_USER_ID=kuroneko,shiro,gin
# WEBCHAT_AGENT_SECRET=
