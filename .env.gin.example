# Agent 3（Gin）— 模型/渠道与 Kuroneko、Shiro 相同；独立 data-gin + 端口 8789
# 用法：复制为 .env.gin，并从 .env.agent2 填入相同的 LOCALMODULE_* / MEM9_* / WEBCHAT_* secret
# 启动：npm run dev:gin
# chat-server 需保留三 agent：WEBCHAT_AGENT_USER_ID=kuroneko,shiro,gin（见 .env.chat-server.example）

ZHIPU_API_KEY=

UTLRA_INNER_LLM_PROVIDER=localmodule
LOCALMODULE_API_KEY=
LOCALMODULE_BASE_URL=https://ai.pocketcity.com
LOCALMODULE_MODEL=GLM-5.1-FP8
LOCALMODULE_VISION_MODEL=MiMo-V2.5

MEM9_API_KEY=
DRIVE9_SERVER=https://api.drive9.ai
DRIVE9_API_KEY=

UTLRA_AGENT_IM_SID=idp:agent:gin
UTLRA_AGENT_NAME=Gin

# 以下两行必须各占一行（勿与注释写在同一行，否则会被 dotenv 忽略）
UTLRA_DATA_ROOT=packages/server/data-gin
PORT=8789

UTLRA_OUTER_REPLY_LLM=1
UTLRA_OUTER_RUN_INNER=0
UTLRA_KPI_AUTO_NEXT_BURST=1
UTLRA_OUTER_PROACTIVE_LEVEL=0
UTLRA_OUTER_MAX_AGENT_CHAIN=20

UTLRA_CHAT_CHANNEL=webchat

WEBCHAT_API_BASE=http://127.0.0.1:8790
WEBCHAT_WS_URL=ws://127.0.0.1:8790/ws
WEBCHAT_AGENT_USER_ID=gin
WEBCHAT_AGENT_DISPLAY_NAME=Gin
WEBCHAT_AGENT_SECRET=dev-shared-secret-change-me
WEBCHAT_GLOBAL_THREAD_ID=global
WEBCHAT_MIRROR_ASSETS=1
WEBCHAT_TENANT=default
WEBCHAT_PEER_AGENT_USER_IDS=kuroneko,shiro
